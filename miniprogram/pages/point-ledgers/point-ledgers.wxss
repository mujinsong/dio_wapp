.ledger-page {
  background: #f7f8fb;
}

.balance-band {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-left: 10rpx solid #f7c948;
  border-radius: 8rpx;
  background: #111827;
  padding: 30rpx;
}

.balance-label {
  color: #cbd5e1;
  font-size: 26rpx;
}

.balance-value {
  color: #f7c948;
  font-size: 44rpx;
  font-weight: 900;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 0 18rpx;
}

.section-title {
  color: #172033;
  font-size: 31rpx;
  font-weight: 900;
}

.section-count {
  color: #8a94a5;
  font-size: 23rpx;
}

.ledger-list {
  overflow: hidden;
  border: 1rpx solid #e5eaf2;
  border-radius: 8rpx;
  background: #ffffff;
}

.ledger-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx;
  border-bottom: 1rpx solid #edf0f4;
}

.ledger-main {
  min-width: 0;
  flex: 1;
}

.ledger-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.ledger-meta,
.ledger-remark,
.ledger-balance {
  color: #8a94a5;
  font-size: 22rpx;
  line-height: 1.5;
}

.ledger-meta {
  margin-top: 8rpx;
}

.ledger-remark {
  margin-top: 6rpx;
  color: #667085;
  overflow-wrap: anywhere;
}

.ledger-side {
  flex: 0 0 150rpx;
  text-align: right;
}

.ledger-delta {
  font-size: 31rpx;
  font-weight: 900;
}

.ledger-delta.positive {
  color: #15736d;
}

.ledger-delta.negative {
  color: #b42318;
}

.ledger-balance {
  margin-top: 8rpx;
}

.load-state {
  padding: 24rpx;
  color: #8a94a5;
  font-size: 23rpx;
  text-align: center;
}

.state-panel {
  border: 1rpx solid #e5eaf2;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 54rpx 30rpx;
  color: #8a94a5;
  font-size: 26rpx;
  text-align: center;
}

.state-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 900;
}

.state-copy {
  margin-top: 12rpx;
  line-height: 1.6;
}

.error {
  margin-top: 20rpx;
  border-radius: 8rpx;
  background: #fef3f2;
  padding: 18rpx 20rpx;
  color: #b42318;
  font-size: 25rpx;
}

<view class="page ledger-page">
  <view class="balance-band">
    <text class="balance-label">当前可用积分</text>
    <text class="balance-value">{{balance}}</text>
  </view>

  <view class="section-head">
    <text class="section-title">变动记录</text>
    <text class="section-count">{{items.length}} 条</text>
  </view>

  <view wx:if="{{loading && !hasItems}}" class="state-panel">正在加载积分明细</view>

  <view wx:elif="{{hasItems}}" class="ledger-list">
    <view wx:for="{{items}}" wx:key="id" class="ledger-item">
      <view class="ledger-main">
        <view class="ledger-title">{{item.title_text}}</view>
        <view class="ledger-meta">{{item.group_text}} · {{item.time_text}}</view>
        <view class="ledger-remark">{{item.remark_text}}</view>
      </view>
      <view class="ledger-side">
        <view class="{{item.delta_class}}">{{item.delta_text}}</view>
        <view class="ledger-balance">{{item.balance_text}}</view>
      </view>
    </view>
    <view class="load-state">{{loadingMore ? '正在加载' : (hasMore ? '继续上拉加载' : '已显示全部记录')}}</view>
  </view>

  <view wx:else class="state-panel">
    <view class="state-title">暂无积分变动</view>
    <view class="state-copy">积分入账、兑换和退款记录会显示在这里</view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>

.operations-page {
  padding-bottom: 64rpx;
}

.page-head,
.list-head,
.operation-top,
.operation-amount {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.page-head {
  align-items: flex-start;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
}

.agency-picker {
  color: #167c76;
  font-size: 24rpx;
  font-weight: 600;
}

.type-control {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 24rpx;
  padding: 5rpx;
  border-radius: 8rpx;
  background: #e8edf4;
}

.type-option {
  height: 66rpx;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  background: transparent;
  color: #667085;
  font-size: 25rpx;
  line-height: 66rpx;
}

.type-option.active {
  background: #ffffff;
  color: #172033;
  font-weight: 650;
}

.filter-band {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #dfe5ee;
  border-radius: 8rpx;
  background: #ffffff;
}

.date-row,
.query-row {
  display: grid;
  align-items: stretch;
  gap: 10rpx;
}

.date-row {
  grid-template-columns: minmax(0, 1fr) 34rpx minmax(0, 1fr);
}

.date-picker {
  min-width: 0;
}

.date-value {
  display: flex;
  height: 68rpx;
  padding: 8rpx 15rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
  border-radius: 6rpx;
  background: #f1f4f8;
  color: #172033;
  font-size: 23rpx;
  white-space: nowrap;
}

.date-value text:first-child {
  color: #7a8497;
  font-size: 18rpx;
}

.date-separator {
  align-self: center;
  color: #7a8497;
  font-size: 21rpx;
  text-align: center;
}

.query-row {
  grid-template-columns: 160rpx minmax(0, 1fr) 105rpx;
  margin-top: 12rpx;
}

.status-value,
.keyword-input,
.query-button {
  height: 68rpx;
  box-sizing: border-box;
  border-radius: 6rpx;
  font-size: 23rpx;
}

.status-value {
  padding: 0 14rpx;
  background: #f1f4f8;
  color: #172033;
  line-height: 68rpx;
}

.keyword-input {
  min-width: 0;
  padding: 0 15rpx;
  border: 1rpx solid #dfe5ee;
  background: #ffffff;
}

.query-button {
  width: 105rpx;
  margin: 0;
  padding: 0;
  background: #111827;
  color: #ffffff;
  line-height: 68rpx;
}

.list-head {
  margin: 25rpx 0 12rpx;
}

.result-count {
  color: #667085;
  font-size: 23rpx;
}

.export-button {
  height: 60rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #bed6d3;
  border-radius: 6rpx;
  background: #eef8f6;
  color: #167c76;
  font-size: 22rpx;
  line-height: 58rpx;
}

.operation-list {
  overflow: hidden;
  border: 1rpx solid #dfe5ee;
  border-radius: 8rpx;
  background: #ffffff;
}

.operation-row {
  position: relative;
  padding: 23rpx 24rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.operation-row:last-child {
  border-bottom: 0;
}

.operation-title {
  min-width: 0;
  color: #172033;
  font-size: 27rpx;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.status-pill {
  flex: 0 0 auto;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  background: #e7f4f1;
  color: #167c76;
  font-size: 19rpx;
}

.status-pill.pending {
  background: #fff3df;
  color: #9a620e;
}

.status-pill.rejected,
.status-pill.canceled,
.status-pill.expired {
  background: #fdeaea;
  color: #b13d3d;
}

.status-pill.redeemed {
  background: #eaf3ff;
  color: #3978b8;
}

.operation-meta,
.operation-code,
.operation-note {
  margin-top: 7rpx;
  color: #7a8497;
  font-size: 21rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.operation-code {
  color: #596579;
  font-family: Menlo, Monaco, monospace;
}

.operation-note {
  color: #9a620e;
}

.operation-amount {
  margin-top: 12rpx;
  padding-top: 11rpx;
  border-top: 1rpx solid #edf0f5;
  color: #167c76;
  font-size: 24rpx;
  font-weight: 650;
}

.empty-band,
.error-band,
.loading-more {
  padding: 30rpx 22rpx;
  border: 1rpx solid #dfe5ee;
  border-radius: 8rpx;
  background: #ffffff;
  color: #7a8497;
  font-size: 24rpx;
  text-align: center;
}

.loading-more {
  padding: 20rpx;
  border: 0;
  background: transparent;
  font-size: 21rpx;
}

.error-band {
  margin-top: 20rpx;
  border-color: #f2caca;
  background: #fff2f2;
  color: #aa3434;
}

@media (max-width: 360px) {
  .query-row {
    grid-template-columns: 145rpx minmax(0, 1fr);
  }

  .query-button {
    grid-column: 1 / -1;
    width: 100%;
  }
}

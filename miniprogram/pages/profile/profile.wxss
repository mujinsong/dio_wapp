.profile-page {
  background: #f7f8fb;
}

.profile-card {
  position: relative;
  overflow: hidden;
  border-radius: 8rpx;
  background: #111827;
  padding: 44rpx 34rpx 34rpx;
  color: #ffffff;
  text-align: center;
}

.profile-card::before {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 16rpx;
  background: repeating-linear-gradient(90deg, #f7c948 0, #f7c948 36rpx, #ef5b5b 36rpx, #ef5b5b 72rpx, #2f9c95 72rpx, #2f9c95 108rpx);
  content: "";
}

.avatar-ring {
  position: relative;
  z-index: 1;
  display: flex;
  width: 126rpx;
  height: 126rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  border: 4rpx solid rgba(247, 201, 72, 0.5);
  border-radius: 50%;
}

.avatar {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f7c948;
  color: #111827;
  font-size: 42rpx;
  font-weight: 900;
}

.profile-name {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
}

.profile-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  color: #cbd5e1;
  font-size: 24rpx;
}

.point-strip {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  padding: 24rpx;
}

.point-label {
  color: #cbd5e1;
  font-size: 26rpx;
}

.point-value {
  color: #f7c948;
  font-size: 42rpx;
  font-weight: 900;
}

.info-list {
  margin-top: 24rpx;
  border: 1rpx solid #e5eaf2;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 8rpx 30rpx;
}

.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.row:last-child {
  border-bottom: 0;
}

.key {
  flex: 0 0 150rpx;
  color: #667085;
  font-size: 26rpx;
}

.value {
  flex: 1;
  color: #172033;
  font-size: 26rpx;
  font-weight: 700;
  text-align: right;
  overflow-wrap: anywhere;
}

.report-page {
  padding-bottom: 64rpx;
}

.page-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 700;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 25rpx;
}

.agency-picker,
.agency-name {
  max-width: 260rpx;
  color: #167c76;
  font-size: 25rpx;
  font-weight: 600;
  text-align: right;
  overflow-wrap: anywhere;
}

.filter-band {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 36rpx minmax(0, 1fr) 112rpx;
  align-items: stretch;
  gap: 12rpx;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx solid #dfe5ee;
  border-radius: 8rpx;
}

.date-picker {
  min-width: 0;
}

.date-value {
  display: flex;
  height: 72rpx;
  padding: 8rpx 14rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
  background: #f4f6f9;
  border-radius: 6rpx;
  color: #172033;
  font-size: 24rpx;
  white-space: nowrap;
}

.date-value text:first-child {
  color: #7a8497;
  font-size: 20rpx;
}

.date-separator {
  align-self: center;
  color: #7a8497;
  font-size: 22rpx;
  text-align: center;
}

.filter-button {
  width: 112rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  background: #111827;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.attention-band {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 2rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border: 1rpx solid #d9e7e5;
  border-radius: 8rpx;
  background: #d9e7e5;
}

.attention-item {
  display: flex;
  min-width: 0;
  padding: 24rpx;
  flex-direction: column;
  background: #eef8f6;
}

.attention-item.warning {
  background: #fff6e8;
}

.attention-label,
.metric-label {
  color: #667085;
  font-size: 23rpx;
}

.attention-value {
  margin-top: 10rpx;
  color: #145f5b;
  font-size: 34rpx;
  font-weight: 700;
}

.warning .attention-value {
  color: #9a5c08;
}

.attention-note,
.metric-note {
  margin-top: 4rpx;
  color: #7a8497;
  font-size: 21rpx;
}

.section-title {
  margin: 36rpx 0 16rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border: 1rpx solid #dfe5ee;
  border-radius: 8rpx;
  overflow: hidden;
  background: #dfe5ee;
  gap: 1rpx;
}

.metric-item {
  display: flex;
  min-width: 0;
  min-height: 128rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  flex-direction: column;
  background: #ffffff;
}

.metric-item.wide {
  grid-column: 1 / -1;
}

.metric-value {
  margin-top: 7rpx;
  color: #172033;
  font-size: 34rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.data-list {
  overflow: hidden;
  border: 1rpx solid #dfe5ee;
  border-radius: 8rpx;
  background: #ffffff;
}

.staff-row,
.movement-row {
  display: flex;
  min-width: 0;
  padding: 24rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.staff-row:last-child,
.movement-row:last-child {
  border-bottom: 0;
}

.staff-main,
.movement-main {
  min-width: 0;
  flex: 1;
}

.staff-name,
.movement-title {
  color: #172033;
  font-size: 27rpx;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.staff-meta,
.movement-meta {
  display: block;
  margin-top: 6rpx;
  color: #7a8497;
  font-size: 22rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.staff-number {
  display: flex;
  max-width: 250rpx;
  flex-direction: column;
  align-items: flex-end;
  color: #167c76;
  font-size: 24rpx;
  font-weight: 650;
  text-align: right;
}

.staff-number text:last-child {
  margin-top: 5rpx;
  color: #667085;
  font-size: 21rpx;
  font-weight: 400;
}

.movement-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.movement-type {
  padding: 3rpx 9rpx;
  border-radius: 4rpx;
  background: #eef2f7;
  color: #596579;
  font-size: 19rpx;
  font-weight: 500;
  white-space: nowrap;
}

.movement-delta {
  width: 86rpx;
  flex: 0 0 86rpx;
  font-size: 29rpx;
  font-weight: 700;
  text-align: right;
}

.movement-delta.increase {
  color: #167c76;
}

.movement-delta.decrease {
  color: #c34545;
}

.empty-band,
.error-band {
  padding: 32rpx 24rpx;
  border: 1rpx solid #dfe5ee;
  border-radius: 8rpx;
  background: #ffffff;
  color: #7a8497;
  font-size: 25rpx;
  text-align: center;
}

.error-band {
  margin-top: 24rpx;
  border-color: #f2caca;
  background: #fff2f2;
  color: #aa3434;
}

@media (max-width: 360px) {
  .filter-band {
    grid-template-columns: minmax(0, 1fr) 28rpx minmax(0, 1fr);
  }

  .filter-button {
    grid-column: 1 / -1;
    width: 100%;
  }
}
.reconciliation-band { margin-top: 32rpx; border-top: 1rpx solid #dce2ea; padding-top: 12rpx; }
.reconciliation-button { margin: 20rpx 0; width: 100%; box-sizing: border-box; }
.reconciliation-summary { font-size: 26rpx; line-height: 1.7; overflow-wrap: anywhere; }
.reconciliation-issue { border-bottom: 1rpx solid #dce2ea; padding: 18rpx 0; }

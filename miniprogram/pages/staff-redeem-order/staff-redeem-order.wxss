.staff-redeem-page {
  background: #f7f8fb;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0 34rpx;
}

.eyebrow {
  color: #c04736;
  font-size: 22rpx;
  font-weight: 900;
}

.title {
  margin-top: 8rpx;
  color: #172033;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.15;
}

.scan-button {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #172033;
}

.scan-button::after {
  border: 0;
}

.scan-corner {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border-color: #f7c948;
  border-style: solid;
}

.corner-a {
  top: 22rpx;
  left: 22rpx;
  border-width: 4rpx 0 0 4rpx;
}

.corner-b {
  top: 22rpx;
  right: 22rpx;
  border-width: 4rpx 4rpx 0 0;
}

.corner-c {
  bottom: 22rpx;
  left: 22rpx;
  border-width: 0 0 4rpx 4rpx;
}

.corner-d {
  right: 22rpx;
  bottom: 22rpx;
  border-width: 0 4rpx 4rpx 0;
}

.form-panel,
.result-panel {
  border: 1rpx solid #e5eaf2;
  border-radius: 8rpx;
  background: #ffffff;
}

.form-panel {
  overflow: hidden;
  padding: 30rpx;
  box-shadow: 0 18rpx 42rpx rgba(23, 32, 51, 0.08);
}

.label {
  margin-bottom: 12rpx;
  color: #344054;
  font-size: 24rpx;
  font-weight: 800;
}

.scan-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  border: 1rpx solid #dde3ec;
  border-radius: 8rpx;
  background: #f9fafc;
  padding: 0 24rpx;
  color: #172033;
  font-size: 28rpx;
}

.token-input {
  min-width: 0;
  flex: 1;
}

.small-button {
  width: 138rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #172033;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.small-button::after {
  border: 0;
}

.submit-button {
  margin-top: 34rpx;
}

.result-panel {
  margin-top: 28rpx;
  overflow: hidden;
}

.result-panel::before {
  display: block;
  height: 10rpx;
  background: linear-gradient(90deg, #f7c948 0 42%, #ef5b5b 42% 72%, #2f9c95 72% 100%);
  content: "";
}

.result-title {
  padding: 28rpx 30rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
}

.result-line {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 30rpx;
  border-top: 1rpx solid #edf0f4;
  color: #667085;
  font-size: 25rpx;
}

.result-line text:first-child {
  flex: 0 0 100rpx;
}

.result-line text:last-child {
  min-width: 0;
  flex: 1;
  color: #172033;
  font-weight: 900;
  text-align: right;
  overflow-wrap: anywhere;
}

.error {
  margin-top: 24rpx;
  border-radius: 8rpx;
  background: #fef3f2;
  padding: 18rpx 20rpx;
  color: #b42318;
  font-size: 26rpx;
}

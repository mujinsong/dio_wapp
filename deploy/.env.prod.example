MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_PASSWORD=replace-with-random-app-password
MYSQL_DSN=dio_app:replace-with-random-app-password@tcp(mysql:3306)/dio_wapp?charset=utf8mb4&parseTime=True&loc=Local
REDIS_PASSWORD=replace-with-random-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=604800
ORDER_REDEEM_TTL_HOURS=24
ORDER_EXPIRY_SCAN_SECONDS=60
MAINTENANCE_SCAN_SECONDS=3600
IDEMPOTENCY_RETENTION_HOURS=168
WECHAT_APPID=your-wechat-miniprogram-appid
WECHAT_SECRET=your-wechat-miniprogram-secret
# 首次部署至少配置一个管理员 OpenID；多个值使用英文逗号分隔。
ADMIN_OPENIDS=
STAFF_OPENIDS=
TEAM_LEADER_OPENIDS=
DEFAULT_AGENCY_NAME=默认事务所
